# ============================================================
# Contoh environment variable (PRD 23.2) — salin nilai asli ke
# .env.local (development) dan ke Project Settings → Environment
# Variables di Vercel (production). JANGAN pernah meng-commit
# nilai asli; berkas ini hanya berisi nama variabel.
# ============================================================

# URL proyek Supabase (aman di klien) — Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (aman di klien, dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret / service role key — RAHASIA, hanya server & cron (PRD 7.4)
SUPABASE_SERVICE_ROLE_KEY=

# String acak panjang untuk melindungi /api/cron/cleanup
CRON_SECRET=

# Alamat publik aplikasi — localhost saat dev, domain final saat produksi
NEXT_PUBLIC_SITE_URL=
